# Copie este arquivo para .env e preencha com os dados do projeto Supabase.
# Nunca commite o arquivo .env.

# Usadas no navegador (Vite)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Usadas no servidor
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chave administrativa: uso exclusivo no servidor
SUPABASE_SERVICE_ROLE_KEY=

# --- Docker (opcional) -------------------------------------------------------
# Porta do host onde o site fica disponível (contêiner frontend/Nginx)
HTTP_PORT=8080
# Prefixo do nome das imagens (ex.: ghcr.io/mkrosz/setec)
IMAGE_PREFIX=setec
# URL publicada do projeto na Lovable, para servir as logos hospedadas lá (/__l5e/...)
LOVABLE_ASSETS_ORIGIN=
# APP_VERSION, GIT_COMMIT e BUILD_DATE são preenchidas pelo scripts/docker/deploy.sh
